PORT=5000
# Atlas: Cluster > Connect > Drivers. Replace <username> and <password> with
# a database user's credentials; percent-encode special password characters.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=yourtube2
# Optional: set DNS server IPs if this machine refuses Atlas SRV lookups.
MONGODB_DNS_SERVERS=
FRONTEND_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
MAILPIT_SMTP_PORT=1025
# Keep email off until you explicitly choose local Mailpit or external SMTP.
EMAIL_DELIVERY_DISABLED=true
TRUSTED_DEVICE_DAYS=30
# Set exact IPs of reverse proxies allowed to supply X-Forwarded-For.
TRUSTED_PROXY_IPS=
# Optional local MaxMind GeoLite2/GeoIP2 City MMDB file. Login still works
# without it; private and loopback addresses cannot be geolocated.
GEOIP_CITY_DB_PATH=
WATCH_COMPLETE_PERCENT=90
COMMENT_EDIT_WINDOW_MINUTES=15
COMMENT_TRANSLATE_PORT=5001
COMMENT_TRANSLATE_LANGUAGES=en,hi,es,fr,ur
# Optional Cloudflare Turnstile keys for real verification after repeated posts.
# Without both keys, the local arithmetic challenge remains active.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WebRTC uses Cloudflare's public STUN server by default. For reliable calls
# across restrictive networks, configure a TURN relay. URLs are comma separated.
ROOM_STUN_URLS=stun:stun.cloudflare.com:3478
ROOM_TURN_URLS=
ROOM_TURN_USERNAME=
ROOM_TURN_CREDENTIAL=

# Razorpay Test. Set all three secrets and the nine Test plan IDs to enable checkout.
# Configure the Test webhook URL as /subscriptions/razorpay/webhook and subscribe
# to subscription.charged, subscription.cancelled, subscription.completed and subscription.halted.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BRONZE_MONTHLY=
RAZORPAY_PLAN_BRONZE_QUARTERLY=
RAZORPAY_PLAN_BRONZE_YEARLY=
RAZORPAY_PLAN_SILVER_MONTHLY=
RAZORPAY_PLAN_SILVER_QUARTERLY=
RAZORPAY_PLAN_SILVER_YEARLY=
RAZORPAY_PLAN_GOLD_MONTHLY=
RAZORPAY_PLAN_GOLD_QUARTERLY=
RAZORPAY_PLAN_GOLD_YEARLY=

# If SMTP_HOST is blank, receipts and OTPs go to local Mailpit. External SMTP
# requires TLS, a sender address, and authentication. SMTP_SECURE=true uses
# implicit TLS (usually port 465); false uses STARTTLS (usually port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_EMAIL=support@yourtube.local

# Seller and tax fields for test invoice details. Test payments cannot issue
# legally valid tax invoices; configure business details before live billing.
INVOICE_SELLER_NAME=
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_GSTIN=
INVOICE_TAX_RATE_PERCENT=
